							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Engineering\",\n    \"description\": \"Software development and engineering team\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/departments",
